{
  "mcpServers": {
    "virtual-computer-fly": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "mcp-virtual-computer",
        "--backend",
        "fly"
      ],
      "env": {
        "COMPUTER_ID": "agent-workstation",
        "DESKTOP_ENVIRONMENT": "true",
        "NETWORK_ACCESS": "true",
        "AUTO_INSTALL_FLYCTL": "true",
        "EXPOSE_LIFECYCLE_TOOLS": "false"
      }
    }
  }
}
